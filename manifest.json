{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "version_name": "1.0.0 — Ollama first",
  "default_locale": "fa",
  "minimum_chrome_version": "116",

  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],

  "host_permissions": [
    "https://www.digikala.com/*",
    "https://digikala.com/*",
    "https://basalam.com/*",
    "https://www.basalam.com/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.digikala.com/*",
        "https://digikala.com/*",
        "https://basalam.com/*",
        "https://www.basalam.com/*"
      ],
      "js": [
        "shared/utils.js",
        "shared/act.js",
        "shared/sites.js",
        "content/adapters/digikala.js",
        "content/adapters/basalam.js",
        "content/adapters/index.js",
        "content/actions/dom.js",
        "content/actions/interact.js",
        "content/actions/extract.js",
        "content/actions/hud.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandOpen__"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
